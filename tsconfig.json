{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "../src/data/duas/**/*.ts",
    "../src/data/duas/**/*.json",
    "../src/data/daily-manuscript.json",
    "../src/lib/data/99-names.ts",
    "../src/lib/utils/crisis-detection.ts",
    "../src/lib/utils/arabic-normalise.ts",
    "../src/lib/utils/distress-detection.ts"
  ],
  "exclude": ["node_modules"]
}
