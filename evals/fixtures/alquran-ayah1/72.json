{"code":200,"status":"OK","data":[{"number":5448,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أُوحِىَ إِلَىَّ أَنَّهُ ٱسْتَمَعَ نَفَرٌۭ مِّنَ ٱلْجِنِّ فَقَالُوٓا۟ إِنَّا سَمِعْنَا قُرْءَانًا عَجَبًۭا","edition":{"identifier":"quran-uthmani","language":"ar","name":"القرآن الكريم برسم العثماني (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"},"surah":{"number":72,"name":"سُورَةُ الجِنِّ","englishName":"Al-Jinn","englishNameTranslation":"The Jinn","numberOfAyahs":28,"revelationType":"Meccan"},"numberInSurah":1,"juz":29,"manzil":7,"page":572,"ruku":506,"hizbQuarter":229,"sajda":false},{"number":5448,"text":"Say (O Muhammad): It is revealed unto me that a company of the Jinn gave ear, and they said: Lo! we have heard a marvellous Qur'an,","edition":{"identifier":"en.pickthall","language":"en","name":"Pickthall","englishName":"Mohammed Marmaduke William Pickthall","format":"text","type":"translation","direction":"ltr"},"surah":{"number":72,"name":"سُورَةُ الجِنِّ","englishName":"Al-Jinn","englishNameTranslation":"The Jinn","numberOfAyahs":28,"revelationType":"Meccan"},"numberInSurah":1,"juz":29,"manzil":7,"page":572,"ruku":506,"hizbQuarter":229,"sajda":false}]}